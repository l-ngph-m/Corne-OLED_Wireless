#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <24 30>;
            layers = <1>;
        };

        bt_nxt {
            bindings = <&bt BT_NXT>;
            key-positions = <24 31>;
            layers = <1>;
        };

        bt_prv {
            bindings = <&bt BT_PRV>;
            key-positions = <24 32>;
            layers = <1>;
        };
    };

    behaviors {
        open_bracket: open_bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "OPEN_BRACKET";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_PARENTHESIS>,
                <&kp LEFT_BRACKET>,
                <&kp LEFT_BRACE>;

            tapping-term-ms = <200>;
        };

        close_bracket: close_bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "CLOSE_BRACKET";
            #binding-cells = <0>;
            bindings =
                <&kp RIGHT_PARENTHESIS>,
                <&kp RIGHT_BRACKET>,
                <&kp RIGHT_BRACE>;

            tapping-term-ms = <200>;
        };

        mouse_scroll_mod_tap: mouse_scroll_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSE_SCROLL_MOD_TAP";
            #binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tapping-term-ms = <150>;
            flavor = "balanced";
        };

        mouse_move_mod_tap: mouse_move_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSE_MOVE_MOD_TAP";
            bindings = <&mmv>, <&mmv>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "hold-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB           &kp Q  &kp W  &kp E                  &kp R  &kp T        &kp Y                     &kp U         &kp I         &kp O    &kp P     &kp LEFT_BRACKET
&mt LCTRL ESCAPE  &kp A  &kp S  &kp D                  &kp F  &kp G        &kp H                     &kp J         &kp K         &kp L    &kp SEMI  &kp SQT
&kp LSHFT         &kp Z  &kp X  &kp C                  &kp V  &kp B        &kp N                     &kp M         &kp COMMA     &kp DOT  &kp FSLH  &kp BACKSLASH
                                &mt LEFT_ALT LEFT_WIN  &mo 1  &kp SPACE    &mt LEFT_SHIFT BACKSPACE  &lt 2 RETURN  &kp LEFT_WIN
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE  &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp STAR  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET
&trans     &kp N1    &kp N2  &kp N3    &kp N4      &kp N5         &kp LEFT   &kp DOWN       &kp UP    &kp RIGHT             &kp MINUS              &kp EQUAL
&trans     &kp N6    &kp N7  &kp N8    &kp N9      &kp N0         &none      &none          &none     &none                 &none                  &none
                             &trans    &trans      &trans         &trans     &trans         &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TILDE  &mouse_scroll_mod_tap SCRL_UP MOVE_Y(20)     &mouse_move_mod_tap MOVE_UP MOVE_Y(500)     &mkp MB1                                    &mkp RCLK  &none     &none   &kp N7  &kp N8  &kp NUMBER_9  &kp NUMBER_0  &kp BACKSPACE
&trans     &mouse_move_mod_tap MOVE_LEFT MOVE_X(-500)   &mouse_move_mod_tap MOVE_DOWN MOVE_Y(-500)  &mouse_move_mod_tap MOVE_RIGHT MOVE_X(500)  &none      &none     &none   &kp N4  &kp N5  &kp N6        &none         &none
&trans     &mouse_scroll_mod_tap SCRL_DOWN MOVE_Y(-20)  &none                                       &none                                       &none      &none     &none   &kp N1  &kp N2  &kp N3        &none         &none
                                                                                                    &trans                                      &trans     &trans    &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV  &kp C_PLAY_PAUSE    &kp C_NEXT  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none    &kp PRINTSCREEN  &kp DELETE
&kp F1  &kp F2      &kp F3        &kp F4        &kp F5      &kp F6              &kp F7      &kp F8                &kp F9                &kp F10  &kp F11          &kp F12
&none   &none       &none         &none         &none       &none               &none       &none                 &none                 &none    &none            &none
                                  &trans        &trans      &trans              &trans      &trans                &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        function_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
